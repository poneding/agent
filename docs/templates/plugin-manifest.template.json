{
  "schema_version": 1,
  "name": "example-plugin",
  "version": "0.1.0",
  "runtime_compatibility": {
    "min_agent_version": "0.1.0",
    "api_version": 1
  },
  "isolation": {
    "mode": "process",
    "entrypoint": "bin/example-plugin"
  },
  "capabilities": [
    {
      "kind": "tool",
      "name": "example.read",
      "permissions": ["fs.read"]
    }
  ],
  "tools": [
    {
      "name": "example.read",
      "description": "Read example data through the plugin.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "content": { "type": "string" }
        },
        "required": ["content"],
        "additionalProperties": false
      }
    }
  ],
  "hooks": [],
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false
  }
}
